# ClicAgenda · variables de entorno (copiar a backend/.env)

NODE_ENV=development
APP_NAME=ClicAgenda

# Neon PostgreSQL (obligatorio)
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# JWT (cambiar en producción)
JWT_SECRET=change-me-in-production
SUPERADMIN_TOKEN_SECRET=change-me-superadmin-token

# URLs locales
FRONTEND_URL=http://localhost:5174
PANEL_URL=http://localhost:5174
BACKEND_PORT=5001

# Vercel: FRONTEND_URL y PANEL_URL = https://tu-proyecto.vercel.app
